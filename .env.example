# ---- Where does the save come from? (choose one option) ----------------------------------------
# a) Server API of the dedicated server (easiest: only address + admin password, port = game port)
SAVE_SOURCE=api://my-server.example:7777
SAVE_PASSWORD=admin-password
#    instead of a password you can also use a token (server console: server.GenerateAPIToken)
# SAVE_TOKEN=

# b) SFTP — e.g. Pterodactyl (port 2022, user <panelname>.<server-id>, password = panel password)
# SAVE_SOURCE=sftp://player.1a2b3c4d@panel.example:2022/.config/Epic/FactoryGame/Saved/SaveGames/server
# SAVE_PASSWORD=
# SAVE_KEY=/run/secrets/id_ed25519          # instead of a password: key file (mount it into the container)

# c) FTP/FTPS — many server hosters
# SAVE_SOURCE=ftps://user@ftp.host.example:21/FactoryGame/Saved/SaveGames/server
# SAVE_PASSWORD=

# d) Folder (game server on the same machine, mount the volume in docker-compose.yml)
# SAVE_SOURCE=/saves

# Only certain saves (e.g. one session): file name pattern
# SAVE_PATTERN=MySession_*.sav

# ---- Live data (optional) -----------------------------------------------------------------------
# FicsIt Remote Monitoring on the server (mod, see docs/FRM.md). Empty = map from the save only.
# FRM_URL=http://my-server.example:8080

# ---- Other ---------------------------------------------------------------------------------------
# Password for notes, factory names and status (empty = read-only)
MAP_PIN_PASSWORD=
# Name in the top left (empty = session name from the save)
# MAP_TITLE=
# Time zone for timestamps
# TZ=Europe/Berlin
