# ---- Woher kommt das Save? (eine Variante wählen) -----------------------------------------------
# a) Server-API des Dedicated Servers (am einfachsten: nur Adresse + Admin-Passwort, Port = Spielport)
SAVE_SOURCE=api://mein-server.example:7777
SAVE_PASSWORD=admin-passwort
#    statt Passwort geht auch ein Token (Serverkonsole: server.GenerateAPIToken)
# SAVE_TOKEN=

# b) SFTP — z. B. Pterodactyl (Port 2022, Benutzer <panelname>.<server-id>, Passwort = Panel-Passwort)
# SAVE_SOURCE=sftp://spieler.1a2b3c4d@panel.example:2022/.config/Epic/FactoryGame/Saved/SaveGames/server
# SAVE_PASSWORD=
# SAVE_KEY=/run/secrets/id_ed25519          # statt Passwort: Schlüsseldatei (ins Image einhängen)

# c) FTP/FTPS — viele Server-Hoster
# SAVE_SOURCE=ftps://benutzer@ftp.hoster.example:21/FactoryGame/Saved/SaveGames/server
# SAVE_PASSWORD=

# d) Ordner (Gameserver auf demselben Rechner, Volume in docker-compose.yml einhängen)
# SAVE_SOURCE=/saves

# Nur bestimmte Saves (z. B. eine Session): Muster für den Dateinamen
# SAVE_PATTERN=MeineSession_*.sav

# ---- Live-Daten (optional) ----------------------------------------------------------------------
# FicsIt Remote Monitoring auf dem Server (Mod, siehe docs/FRM.md). Leer = Karte nur aus dem Save.
# FRM_URL=http://mein-server.example:8080

# ---- Sonstiges ----------------------------------------------------------------------------------
# Passwort für Notizen, Fabriknamen und -status (leer = nur lesen)
MAP_PIN_PASSWORD=
# Name oben links (leer = Sessionname aus dem Save)
# MAP_TITLE=
# Zeitzone für Zeitangaben
# TZ=Europe/Berlin
